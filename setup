#!/bin/bash

# Bootstrap vim-plug if missing
PLUG_DIR="$HOME/.vim/autoload/plug.vim"
if [ ! -f "$PLUG_DIR" ]; then
    echo "==> Downloading vim-plug..."
    curl -fLo "$PLUG_DIR" --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi

# Description: Link dotfiles to home directory
mkdir -p ~/.config

dotfiles=("bashrc" "vimrc" "tmux.conf")

link_file(){
    for dotfile in "$@"; do
        ln -sf ~/dotfiles/"$dotfile" ~/."$dotfile"
        echo "Linked: $dotfile"
    done
}

link_file "${dotfiles[@]}"

ln -sf ~/dotfiles/starship.toml ~/.config/starship.toml

# Run Vim headlessly to install/update plugins without opening the UI
echo "Installing Vim plugins..."
vim +PlugInstall +qall

echo "Dotfiles linked!"
